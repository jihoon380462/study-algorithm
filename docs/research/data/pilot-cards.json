  "selection_sort": "def selection_sort(a):\n    n = len(a)\n    for i in range(n - 1):\n        m = i\n        for j in range(i + 1, n):\n            if a[j] < a[m]:\n                m = j\n        a[i], a[m] = a[m], a[i]\n    return a\n",
  "bsearch": "def bsearch(a, t):\n    lo, hi = 0, len(a)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if a[mid] == t:\n            return mid\n        if a[mid] < t:\n            lo = mid + 1\n        else:\n            hi = mid\n    return -1\n",
  "balanced": "PAIR = {\")\": \"(\", \"]\": \"[\", \"}\": \"{\"}\n\ndef balanced(s):\n    st = []\n    for ch in s:\n        if ch in \"([{\":\n            st.append(ch)\n        elif not st:\n            return False\n        elif st.pop() != PAIR[ch]:\n            return False\n    return not st\n"
